# ictt-sentinel — environment template
#
# Copy to .env.local and fill in. .env* is gitignored except this file.
#
#   cp .env.example .env.local
#
# RULES
#   - Secret values live here, never in a manifest. The manifest names a
#     variable (secretRef); this file holds what it points at.
#   - Every value below is EMPTY on purpose. There is no default password and
#     no placeholder token that could reach production by accident.
#   - This product holds ZERO chain signing keys. The variables listed under
#     "NEVER DEFINE" are refused at startup, not warned about.

# ---------------------------------------------------------------- runtime
# Standard runtime variables keep their conventional names; they are not
# duplicated under a project prefix just to carry one.
NODE_ENV=development
LOG_LEVEL=info
TZ=UTC

# ---------------------------------------------------------------- database
# Used by infra/postgres/docker-compose.yml and by the agent/api.
POSTGRES_DB=ictt_sentinel
POSTGRES_USER=ictt_sentinel
# Required. Generate one, e.g.:  openssl rand -base64 32
POSTGRES_PASSWORD=
# Assembled from the values above. Host is 127.0.0.1: the local database is
# never published on a routable interface.
DATABASE_URL=

# ------------------------------------------------------- RPC endpoints
# Application-specific variables carry the ICTT_SENTINEL_ prefix. This is the
# only prefix a manifest secretRef may point at.
#
# Two endpoints per chain are required because quorum counts INDEPENDENT trust
# domains. Two URLs from one provider are one witness, not two: put a genuinely
# different provider in SECONDARY or the manifest quorum check will refuse the
# topology (docs/INVARIANTS.md 9).

# Home chain
ICTT_SENTINEL_HOME_RPC_PRIMARY=
ICTT_SENTINEL_HOME_RPC_SECONDARY=
# Optional: full-archive endpoint for replay from the deployment block.
ICTT_SENTINEL_HOME_RPC_ARCHIVE=

# Remote chain: alpha  (one pair per remote in your manifest)
ICTT_SENTINEL_REMOTE_ALPHA_RPC_PRIMARY=
ICTT_SENTINEL_REMOTE_ALPHA_RPC_SECONDARY=
ICTT_SENTINEL_REMOTE_ALPHA_RPC_ARCHIVE=

# ---------------------------------------------------------------- optional data APIs
# Discovery and operational context only. Never a source of a coverage verdict.
ICTT_SENTINEL_GLACIER_API_KEY=

# Webhooks are a latency hint. A webhook never writes a canonical fact; the
# verdict still comes from multi-RPC replay at pinned blocks.
ICTT_SENTINEL_WEBHOOK_SHARED_SECRET=

# ---------------------------------------------------------------- alerting
ICTT_SENTINEL_SLACK_WEBHOOK_URL=
ICTT_SENTINEL_PAGERDUTY_ROUTING_KEY=

# ---------------------------------------------------------------- hosted control plane (optional)
# Only needed when shipping evidence metadata to a hosted plane. The agent uses
# a signed ingestion token; it has no chain signing key of any kind.
ICTT_SENTINEL_CONTROL_PLANE_URL=
ICTT_SENTINEL_CONTROL_PLANE_TOKEN=

# ---------------------------------------------------------------- defaults
# Operational defaults. A manifest or policy file overrides these; they exist so
# a bare `doctor` run has something sane to report against.

# Distinct trust domains that must agree on a pinned block. Below 2 there is no
# witness, only a single point of failure.
ICTT_SENTINEL_QUORUM_MIN_TRUST_DOMAINS=2

# Named finality semantic. Avalanche acceptance is final; there is deliberately
# no confirmation-depth setting (docs/DATA_MODEL.md 3.1).
ICTT_SENTINEL_FINALITY_MODE=accepted-quorum

# Evidence older than this degrades the verdict to UNKNOWN rather than being
# reported as current.
ICTT_SENTINEL_EVIDENCE_MAX_AGE_SECONDS=300
ICTT_SENTINEL_EVIDENCE_EXPIRES_AFTER_SECONDS=86400

# Replay window and data-path limits.
ICTT_SENTINEL_REPLAY_MAX_LOG_RANGE_BLOCKS=2000
ICTT_SENTINEL_RPC_TIMEOUT_MS=10000
ICTT_SENTINEL_RPC_MAX_RETRIES=2

# ---------------------------------------------------------------- NEVER DEFINE
# The following are refused at startup. They are listed so the ban is explicit,
# not so they can be filled in. This tool does not sign, send or pause anything
# (docs/adr/0001-keyless-read-only.md).
#
#   BRIDGE_PRIVATE_KEY
#   MINTER_PRIVATE_KEY
#   PAUSER_PRIVATE_KEY
#   MULTISIG_SIGNER_KEY
#   MNEMONIC
#   SEED_PHRASE
