{
  "name": "@ictt-sentinel/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared domain types and value objects. Pure: no I/O, env, clock or randomness.",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "ictt-sentinel": {
    "layer": 0,
    "mayDependOn": []
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --build --force",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run --root ../.."
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
