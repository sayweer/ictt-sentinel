{
  "name": "@ictt-sentinel/evidence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence bundle format, canonical hashing and export shape.",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "ictt-sentinel": {
    "layer": 1,
    "mayDependOn": [
      "@ictt-sentinel/domain",
      "@ictt-sentinel/invariant-core"
    ]
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --build --force",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "@ictt-sentinel/domain": "workspace:*",
    "@ictt-sentinel/invariant-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
