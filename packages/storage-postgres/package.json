{
  "name": "@ictt-sentinel/storage-postgres",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL persistence for the append-only ledger and evaluations.",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "ictt-sentinel": {
    "layer": 2,
    "mayDependOn": [
      "@ictt-sentinel/domain",
      "@ictt-sentinel/config"
    ]
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --build --force",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run --root ../..",
    "migrate": "node ./dist/cli.js"
  },
  "dependencies": {
    "@ictt-sentinel/config": "workspace:*",
    "@ictt-sentinel/domain": "workspace:*",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
