{
  "name": "@ictt-sentinel/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hosted evidence/control API.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "ictt-sentinel": {
    "layer": 3,
    "mayDependOn": [
      "@ictt-sentinel/domain",
      "@ictt-sentinel/config",
      "@ictt-sentinel/invariant-core",
      "@ictt-sentinel/evidence",
      "@ictt-sentinel/storage-postgres",
      "@ictt-sentinel/alerts"
    ]
  },
  "main": "./dist/index.js",
  "bin": {
    "ictt-sentinel-api": "./dist/main.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --build --force",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "@ictt-sentinel/alerts": "workspace:*",
    "@ictt-sentinel/config": "workspace:*",
    "@ictt-sentinel/domain": "workspace:*",
    "@ictt-sentinel/evidence": "workspace:*",
    "@ictt-sentinel/invariant-core": "workspace:*",
    "@ictt-sentinel/storage-postgres": "workspace:*",
    "fastify": "5.12.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
