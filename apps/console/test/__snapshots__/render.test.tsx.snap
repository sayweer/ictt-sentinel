exports[`every screen state > renders deployments/stale 1`] = `"<main id="main"><h2>Deployments</h2><div class="scroll-x"><table><caption>Deployments this token may read<span class="visually-hidden"> 1 deployments. Each row reports a protocol status and a data status separately, plus how fresh the evidence is.</span></caption><thead><tr><th scope="col">Deployment</th><th scope="col">Protocol status</th><th scope="col">Data status</th><th scope="col">Freshness</th><th scope="col">Last evidence</th><th scope="col">Chains</th></tr></thead><tbody><tr><th scope="row"><a href="#/d/acme-usdc">acme-usdc</a></th><td><span class="badge" data-tone="unknown"><span class="glyph" aria-hidden="true">?</span><span>Not relied upon</span></span><div class="visually-hidden">A protocol result was reported, but the evidence underneath it is not sound, so it is not presented as a healthy verdict.</div></td><td><span class="badge" data-tone="unknown"><span class="glyph" aria-hidden="true">⌛</span><span>Stale</span></span></td><td>Stale · observed 30m ago</td><td><a href="#/d/acme-usdc/evidence/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"><span class="mono" title="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa">aaaaaaaa…aaaaaaaa</span></a><div class="visually-hidden">2026-06-01 11:30:00 UTC</div></td><td>Not shared at approved-full</td></tr></tbody></table></div><p class="caveat">This product reports evidence classes, not a single security score: a breach and a blind spot need opposite responses. All times are UTC.</p></main>"`;

exports[`every screen state > renders deployments/unknown 1`] = `"<main id="main"><h2>Deployments</h2><div class="scroll-x"><table><caption>Deployments this token may read<span class="visually-hidden"> 1 deployments. Each row reports a protocol status and a data status separately, plus how fresh the evidence is.</span></caption><thead><tr><th scope="col">Deployment</th><th scope="col">Protocol status</th><th scope="col">Data status</th><th scope="col">Freshness</th><th scope="col">Last evidence</th><th scope="col">Chains</th></tr></thead><tbody><tr><th scope="row"><a href="#/d/acme-usdc">acme-usdc</a></th><td><span class="badge" data-tone="unknown"><span class="glyph" aria-hidden="true">?</span><span>Not established</span></span><div class="visually-hidden">The evidence does not decide this either way. Unresolved, and never the same as healthy.</div></td><td><span class="badge" data-tone="ok"><span class="glyph" aria-hidden="true">✓</span><span>Complete</span></span></td><td>Fresh · observed 30m ago</td><td><a href="#/d/acme-usdc/evidence/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"><span class="mono" title="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa">aaaaaaaa…aaaaaaaa</span></a><div class="visually-hidden">2026-06-01 11:30:00 UTC</div></td><td>Not shared at approved-full</td></tr></tbody></table></div><p class="caveat">This product reports evidence classes, not a single security score: a breach and a blind spot need opposite responses. All times are UTC.</p></main>"`;

exports[`every screen state > renders deployments/warn 1`] = `"<main id="main"><h2>Deployments</h2><div class="scroll-x"><table><caption>Deployments this token may read<span class="visually-hidden"> 1 deployments. Each row reports a protocol status and a data status separately, plus how fresh the evidence is.</span></caption><thead><tr><th scope="col">Deployment</th><th scope="col">Protocol status</th><th scope="col">Data status</th><th scope="col">Freshness</th><th scope="col">Last evidence</th><th scope="col">Chains</th></tr></thead><tbody><tr><th scope="row"><a href="#/d/acme-usdc">acme-usdc</a></th><td><span class="badge" data-tone="warn"><span class="glyph" aria-hidden="true">!</span><span>Deviation</span></span><div class="visually-hidden">Policy or liveness deviation observed. This is not evidence of an economic breach.</div></td><td><span class="badge" data-tone="ok"><span class="glyph" aria-hidden="true">✓</span><span>Complete</span></span></td><td>Fresh · observed 30m ago</td><td><a href="#/d/acme-usdc/evidence/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"><span class="mono" title="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa">aaaaaaaa…aaaaaaaa</span></a><div class="visually-hidden">2026-06-01 11:30:00 UTC</div></td><td>Not shared at approved-full</td></tr></tbody></table></div><p class="caveat">This product reports evidence classes, not a single security score: a breach and a blind spot need opposite responses. All times are UTC.</p></main>"`;

exports[`every screen state > renders evidence/detail-full 1`] = `"<main id="main"><h2>Evidence record</h2><section class="panel" aria-labelledby="metadata-heading"><h3 id="metadata-heading">Record</h3><dl class="pairs"><div style="display:contents"><dt>Content digest</dt><dd><span class="mono">aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa</span></dd></div><div style="display:contents"><dt>Observed at</dt><dd>2026-06-01 11:30:00 UTC</dd></div><div style="display:contents"><dt>Expires at</dt><dd>2026-06-01 12:30:00 UTC</dd></div><div style="display:contents"><dt>Received at</dt><dd>2026-06-01 11:30:00 UTC</dd></div><div style="display:contents"><dt>Protocol status</dt><dd><span class="badge" data-tone="ok"><span class="glyph" aria-hidden="true">✓</span><span>Reconciled</span></span></dd></div><div style="display:contents"><dt>Data status</dt><dd><span class="badge" data-tone="ok"><span class="glyph" aria-hidden="true">✓</span><span>Complete</span></span></dd></div><div style="display:contents"><dt>Sharing level</dt><dd>approved-full</dd></div><div style="display:contents"><dt>Verification status</dt><dd>verified</dd></div></dl></section><section class="panel" aria-labelledby="provenance-heading"><h3 id="provenance-heading">Provenance</h3><dl class="pairs"><div style="display:contents"><dt>Schema version</dt><dd>ictt-sentinel/evidence/v1</dd></div><div style="display:contents"><dt>Build commit</dt><dd>artifact-addressed</dd></div><div style="display:contents"><dt>Artifact checksum</dt><dd>bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb</dd></div><div style="display:contents"><dt>Source lock commit</dt><dd>8fef6ef73767f4497a72d8348a0774a262e0c535</dd></div><div style="display:contents"><dt>Adapter</dt><dd>ictt-erc20 v1</dd></div><div style="display:contents"><dt>Manifest hash</dt><dd>dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd</dd></div><div style="display:contents"><dt>Policy hash</dt><dd>eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee</dd></div><div style="display:contents"><dt>Previous bundle</dt><dd>none</dd></div></dl></section><section class="panel" aria-labelledby="pinned-heading"><h3 id="pinned-heading">Pinned blocks</h3><div class="scroll-x"><table><caption>Every comparative read is pinned to a block number and hash<span class="visually-hidden"> 1 pinned chains. Comparing two chains at latest is impossible by construction.</span></caption><thead><tr><th scope="col">Chain</th><th scope="col">Block number</th><th scope="col">Block hash</th><th scope="col">Acceptance evidence</th></tr></thead><tbody><tr><th scope="row" class="mono">0x111111…11111111</th><td class="mono">18446744073709551617</td><td class="mono" title="0x4444444444444444444444444444444444444444444444444444444444444444">0x444444…44444444</td><td>accepted-quorum</td></tr></tbody></table></div></section><section class="panel" aria-labelledby="export-heading"><h3 id="export-heading">Offline verification and export</h3><p>This console displays the verification status the API recorded. To verify independently, download the bundle and run \`ictt-sentinel evidence verify --file &lt;path&gt;\` on a machine you trust.</p><p><code>ictt-sentinel evidence verify --file aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.evidence.json</code></p><button type="button">Download bundle</button></section><p class="caveat">An evidence bundle is reproducible and audit-shareable. It is not immutable: anyone who can rewrite the file can recompute its hash. Detection comes from comparing the digest against a record the editor does not control.</p></main>"`;

exports[`every screen state > renders evidence/detail-metadata-only 1`] = `"<main id="main"><h2>Evidence record</h2><section class="panel" aria-labelledby="metadata-heading"><h3 id="metadata-heading">Record</h3><dl class="pairs"><div style="display:contents"><dt>Content digest</dt><dd><span class="mono">aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa</span></dd></div><div style="display:contents"><dt>Observed at</dt><dd>2026-06-01 11:30:00 UTC</dd></div><div style="display:contents"><dt>Expires at</dt><dd>2026-06-01 12:30:00 UTC</dd></div><div style="display:contents"><dt>Received at</dt><dd>2026-06-01 11:30:00 UTC</dd></div><div style="display:contents"><dt>Protocol status</dt><dd><span class="badge" data-tone="ok"><span class="glyph" aria-hidden="true">✓</span><span>Reconciled</span></span></dd></div><div style="display:contents"><dt>Data status</dt><dd><span class="badge" data-tone="ok"><span class="glyph" aria-hidden="true">✓</span><span>Complete</span></span></dd></div><div style="display:contents"><dt>Sharing level</dt><dd>sanitized-metadata</dd></div><div style="display:contents"><dt>Verification status</dt><dd>metadata-only</dd></div></dl></section><section class="panel"><h3>Bundle not shared</h3><p>This record was uploaded as <code>sanitized-metadata</code>, so the bundle itself stayed on the operator&#x27;s machine. The digest above still identifies it: an operator with local access can produce the same bytes and compare.</p></section><p class="caveat">An evidence bundle is reproducible and audit-shareable. It is not immutable: anyone who can rewrite the file can recompute its hash. Detection comes from comparing the digest against a record the editor does not control.</p></main>"`;

exports[`every screen state > renders evidence/list 1`] = `"<main id="main"><h2>Evidence</h2><div class="scroll-x"><table><caption>Evidence records uploaded for this deployment<span class="visually-hidden"> 2 records, newest first. Verification status is what the API recorded; verify independently with the CLI.</span></caption><thead><tr><th scope="col">Digest</th><th scope="col">Observed</th><th scope="col">Protocol</th><th scope="col">Data</th><th scope="col">Sharing</th><th scope="col">Verification</th></tr></thead><tbody><tr><th scope="row"><a href="#/d/acme-usdc/evidence/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"><span class="mono" title="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa">aaaaaaaa…aaaaaaaa</span></a></th><td>2026-06-01 11:30:00 UTC<div class="visually-hidden">30m ago</div></td><td><span class="badge" data-tone="ok"><span class="glyph" aria-hidden="true">✓</span><span>Reconciled</span></span></td><td><span class="badge" data-tone="ok"><span class="glyph" aria-hidden="true">✓</span><span>Complete</span></span></td><td>approved-full</td><td>verified</td></tr><tr><th scope="row"><a href="#/d/acme-usdc/evidence/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"><span class="mono" title="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb">bbbbbbbb…bbbbbbbb</span></a></th><td>2026-06-01 11:30:00 UTC<div class="visually-hidden">30m ago</div></td><td><span class="badge" data-tone="critical"><span class="glyph" aria-hidden="true">✕</span><span>Breach observed</span></span></td><td><span class="badge" data-tone="ok"><span class="glyph" aria-hidden="true">✓</span><span>Complete</span></span></td><td>approved-full</td><td>verified</td></tr></tbody></table></div><p class="caveat">All times are UTC.</p></main>"`;

exports[`every screen state > renders incidents/none 1`] = `"<main id="main"><h2>Incidents</h2><section class="state" data-tone="neutral" aria-labelledby="state-No-incidents-in-the-visible-timeline"><h2 id="state-No-incidents-in-the-visible-timeline">No incidents in the visible timeline</h2><p>Every evaluation in the uploaded verdict timeline reconciled. That is a statement about the records present, not about the whole history of the deployment.</p><p class="remedy">The timeline is bounded by what the agent uploaded and by the page size. Widen it from the evidence page if you need more.</p></section><p class="caveat">Acknowledging mutes paging for one incident. It changes no verdict and performs no chain action. This view is derived from the verdict timeline and does not carry the incident key, so acknowledge from the alerting side.</p></main>"`;

exports[`every screen state > renders incidents/open-and-recovered 1`] = `"<main id="main"><h2>Incidents</h2><div class="scroll-x"><table><caption>Incidents derived from the verdict timeline<span class="visually-hidden"> 2 incidents. Each row shows when it was first seen, how many evaluations folded into it, the worst severity reached, and whether it recovered.</span></caption><thead><tr><th scope="col">First seen</th><th scope="col">Last seen</th><th scope="col">Occurrences</th><th scope="col">Peak severity</th><th scope="col">Current</th><th scope="col">Recovered</th></tr></thead><tbody><tr><th scope="row">2026-06-01 11:00:00 UTC<div class="visually-hidden">1h ago</div></th><td>2026-06-01 11:00:00 UTC</td><td>1<div class="visually-hidden">evaluations deduplicated into this one incident</div></td><td><span class="badge" data-tone="unknown"><span class="glyph" aria-hidden="true">?</span><span>Not established</span></span></td><td><span class="badge" data-tone="unknown"><span class="glyph" aria-hidden="true">?</span><span>Not established</span></span></td><td>still open</td></tr><tr><th scope="row">2026-06-01 08:00:00 UTC<div class="visually-hidden">4h ago</div></th><td>2026-06-01 09:00:00 UTC</td><td>2<div class="visually-hidden">evaluations deduplicated into this one incident</div></td><td><span class="badge" data-tone="critical"><span class="glyph" aria-hidden="true">✕</span><span>Breach observed</span></span></td><td><span class="badge" data-tone="ok"><span class="glyph" aria-hidden="true">✓</span><span>Reconciled</span></span></td><td>2026-06-01 10:00:00 UTC</td></tr></tbody></table></div><section class="panel" aria-labelledby="i-5555555555555555555555555555555555555555555555555555555555555555"><h3 id="i-5555555555555555555555555555555555555555555555555555555555555555">Incident first seen 2026-06-01 11:00:00 UTC</h3><p>This incident is still open. The latest evaluation has not reconciled.</p><section aria-label="Evidence for the incident first seen at 2026-06-01T11:00:00.000Z"><p class="visually-hidden">1 evidence bundles, newest first. Open the oldest one to see what the incident started from.</p><ol class="timeline"><li><a href="#/d/acme-usdc/evidence/5555555555555555555555555555555555555555555555555555555555555555"><span class="mono">55555555…55555555</span></a></li></ol></section></section><section class="panel" aria-labelledby="i-2222222222222222222222222222222222222222222222222222222222222222"><h3 id="i-2222222222222222222222222222222222222222222222222222222222222222">Incident first seen 2026-06-01 08:00:00 UTC</h3><p>This incident recovered: a later evaluation reconciled at its pinned blocks.</p><section aria-label="Evidence for the incident first seen at 2026-06-01T08:00:00.000Z"><p class="visually-hidden">2 evidence bundles, newest first. Open the oldest one to see what the incident started from.</p><ol class="timeline"><li><a href="#/d/acme-usdc/evidence/3333333333333333333333333333333333333333333333333333333333333333"><span class="mono">33333333…33333333</span></a></li><li><a href="#/d/acme-usdc/evidence/2222222222222222222222222222222222222222222222222222222222222222"><span class="mono">22222222…22222222</span></a></li></ol></section></section><p class="caveat">Acknowledging mutes paging for one incident. It changes no verdict and performs no chain action. This view is derived from the verdict timeline and does not carry the incident key, so acknowledge from the alerting side.</p><p class="caveat">Start from the evidence bundle for the first sighting, not from this summary. Reason codes and their runbook entries live in docs/RUNBOOK.md.</p></main>"`;

exports[`every screen state > renders messages/delivered-and-retried 1`] = `"<main id="main"><h2>Message lifecycle</h2><div class="scroll-x"><table><caption>Messages observed in the shared evidence<span class="visually-hidden"> 1 messages. Delivery and execution are separate columns; a delivered message has not necessarily executed.</span></caption><thead><tr><th scope="col">Message</th><th scope="col">Route</th><th scope="col">State</th><th scope="col">Send attempts</th><th scope="col">Execution attempts</th><th scope="col">Economic effects</th><th scope="col">Evidence</th></tr></thead><tbody><tr><th scope="row" class="mono" title="0x7777777777777777777777777777777777777777777777777777777777777777">0x777777…77777777</th><td class="mono">0x1111…111111 → 0x2222…222222</td><td>delivered<div class="visually-hidden">Delivered to the destination messenger. This is NOT execution.</div></td><td>1</td><td>2</td><td>1</td><td><a href="#/d/acme-usdc/evidence/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"><span class="mono">aaaaaaaa…aaaaaaaa</span></a></td></tr></tbody></table></div><section class="panel" aria-labelledby="t-0x7777777777777777777777777777777777777777777777777777777777777777"><h3 id="t-0x7777777777777777777777777777777777777777777777777777777777777777" class="mono">0x777777…77777777</h3><p>Delivered to the destination messenger. This is NOT execution.</p><section aria-label="Transition timeline for message 0x7777777777777777777777777777777777777777777777777777777777777777"><p class="visually-hidden">2 recorded transitions, oldest first. Each links to the raw fact digest it rests on.</p><ol class="timeline"><li><strong>icm-sent</strong><div>The message was sent through Teleporter.</div><div class="mono" title="8888888888888888888888888888888888888888888888888888888888888888">fact 88888888…88888888</div></li><li><strong>delivered</strong><div>Delivered to the destination messenger. This is NOT execution.</div><div class="mono" title="9999999999999999999999999999999999999999999999999999999999999999">fact 99999999…99999999</div></li></ol></section><p>Envelopes: <span class="mono">0xaaaa…aaaaaa</span></p><p class="caveat">This route was retried. Retries are additional attempts, never additional economic effects, and the effect count above reflects that.</p></section><p class="caveat">A causal gap - a transition observed without the transition that must precede it - leaves the message state unresolved rather than advancing it. Unresolved is never rendered as executed.</p></main>"`;

exports[`every screen state > renders messages/empty 1`] = `"<main id="main"><h2>Message lifecycle</h2><section class="state" data-tone="neutral" aria-labelledby="state-No-messages-in-the-shared-evidence"><h2 id="state-No-messages-in-the-shared-evidence">No messages in the shared evidence</h2><p>Either no ICM message was observed in the evaluated window, or the operator has not shared full evidence for this deployment.</p><p class="remedy">Check the sharing level on the overview page. An empty list is not a claim that nothing happened.</p></section></main>"`;

exports[`every screen state > renders messages/unsupported-state 1`] = `"<main id="main"><h2>Message lifecycle</h2><div class="scroll-x"><table><caption>Messages observed in the shared evidence<span class="visually-hidden"> 1 messages. Delivery and execution are separate columns; a delivered message has not necessarily executed.</span></caption><thead><tr><th scope="col">Message</th><th scope="col">Route</th><th scope="col">State</th><th scope="col">Send attempts</th><th scope="col">Execution attempts</th><th scope="col">Economic effects</th><th scope="col">Evidence</th></tr></thead><tbody><tr><th scope="row" class="mono" title="0x7777777777777777777777777777777777777777777777777777777777777777">0x777777…77777777</th><td class="mono">0x1111…111111 → 0x2222…222222</td><td>unsupported<div class="visually-hidden">This build does not interpret this shape, so no claim is made.</div></td><td>1</td><td>2</td><td>1</td><td><a href="#/d/acme-usdc/evidence/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"><span class="mono">aaaaaaaa…aaaaaaaa</span></a></td></tr></tbody></table></div><section class="panel" aria-labelledby="t-0x7777777777777777777777777777777777777777777777777777777777777777"><h3 id="t-0x7777777777777777777777777777777777777777777777777777777777777777" class="mono">0x777777…77777777</h3><p>This build does not interpret this shape, so no claim is made.</p><section aria-label="Transition timeline for message 0x7777777777777777777777777777777777777777777777777777777777777777"><p class="visually-hidden">0 recorded transitions, oldest first. Each links to the raw fact digest it rests on.</p><ol class="timeline"></ol></section><p>Envelopes: <span class="mono">0xaaaa…aaaaaa</span></p><p class="caveat">This route was retried. Retries are additional attempts, never additional economic effects, and the effect count above reflects that.</p></section><p class="caveat">A causal gap - a transition observed without the transition that must precede it - leaves the message state unresolved rather than advancing it. Unresolved is never rendered as executed.</p></main>"`;

exports[`every screen state > renders onboarding/initial 1`] = `"<main id="main"><h2>Onboarding</h2><section class="state" data-tone="neutral"><h3>This console approves nothing</h3><p>This console is read-only. It cannot approve a baseline, register a remote, pause a contract or send a transaction, and it holds no key that could.</p></section><section class="panel" aria-labelledby="checklist-heading"><h3 id="checklist-heading">Baseline review checklist</h3><ol><li style="margin-bottom:0.75rem"><strong>Create the manifest skeleton</strong><div>Writes no secret and asks for none.</div><div><code>ictt-sentinel init</code></div></li><li style="margin-bottom:0.75rem"><strong>Put the RPC URLs in your own secret manager</strong><div>The manifest records the environment variable NAME. The value never enters the repository, this console, or an evidence bundle.</div></li><li style="margin-bottom:0.75rem"><strong>Produce a candidate draft and a diff</strong><div>Discovery proposes. It approves nothing, and a permissionlessly registered remote stays a candidate.</div><div><code>ictt-sentinel discover --manifest deployment.yml --policy policy.yml --json</code></div></li><li style="margin-bottom:0.75rem"><strong>Review the diff with an operator and an auditor, then approve it by hand</strong><div>Baseline legitimacy is created here, by people. The current on-chain state is not automatically the correct baseline, and this page cannot approve it for you.</div></li><li style="margin-bottom:0.75rem"><strong>Check readiness</strong><div>Verifies chain identity, bytecode fingerprints, archive depth, finality policy and which environment variables are missing. Reports secret PRESENCE, never a value.</div><div><code>ictt-sentinel doctor --manifest deployment.yml --policy policy.yml</code></div></li><li style="margin-bottom:0.75rem"><strong>Replay from the deployment block</strong><div>A bounded, pinned, resumable replay. The result is PASS, VIOLATION or UNKNOWN.</div><div><code>ictt-sentinel replay --manifest deployment.yml --policy policy.yml</code></div></li><li style="margin-bottom:0.75rem"><strong>Export an evidence bundle and attach it to your release gate</strong><div>Reproducible and audit-shareable. Verify it offline with the CLI, not in a browser.</div><div><code>ictt-sentinel evidence export --manifest deployment.yml --policy policy.yml</code></div></li><li style="margin-bottom:0.75rem"><strong>Decide what may leave the machine</strong><div>The default is local-only and enabling the hosted plane does not change it. Raising the level is an explicit act.</div></li></ol></section><section class="panel" aria-labelledby="diff-heading"><h3 id="diff-heading">Review a discovery draft</h3><label for="discovery-input">Output of <code>ictt-sentinel discover --json</code></label><textarea id="discovery-input" rows="8" spellCheck="false" aria-describedby="discovery-help"></textarea><p id="discovery-help">Stays in this tab. It is not uploaded, not stored and not logged. A document containing a secret value is refused rather than displayed.</p><button type="button">Summarise draft</button></section></main>"`;

exports[`every screen state > renders overview/failed 1`] = `"<main id="main"><section class="state" data-tone="unknown" aria-labelledby="state-The-console-could-not-load-this"><h2 id="state-The-console-could-not-load-this">The console could not load this</h2><p>The API could not be reached.</p><p class="remedy">Try again later.</p><p class="remedy">This is a console problem and not a verdict about a deployment. Nothing on this page should be read as healthy.</p></section></main>"`;

exports[`every screen state > renders overview/healthy 1`] = `"<main id="main"><h2>Overview</h2><section class="state" data-tone="ok" aria-labelledby="state-Reconciled-at-the-pinned-blocks"><h2 id="state-Reconciled-at-the-pinned-blocks">Reconciled at the pinned blocks</h2><p>Every required check completed on fresh evidence and none of them failed.</p><p class="remedy">Nothing to do. Open the evidence bundle if you need the pinned blocks.</p></section><section class="panel" aria-labelledby="status-heading"><h3 id="status-heading">Verdict fields</h3><dl class="pairs"><div style="display:contents"><dt>Protocol status</dt><dd><span class="badge" data-tone="ok"><span class="glyph" aria-hidden="true">✓</span><span>Reconciled</span></span></dd></div><div style="display:contents"><dt>Protocol meaning</dt><dd>Observed onchain coverage reconciled at the pinned blocks.</dd></div><div style="display:contents"><dt>Data status</dt><dd><span class="badge" data-tone="ok"><span class="glyph" aria-hidden="true">✓</span><span>Complete</span></span></dd></div><div style="display:contents"><dt>Data meaning</dt><dd>Every required observation was collected within its freshness window.</dd></div><div style="display:contents"><dt>Observed at</dt><dd>2026-06-01 11:30:00 UTC (30m ago)</dd></div><div style="display:contents"><dt>Expires at</dt><dd>2026-06-01 12:30:00 UTC</dd></div><div style="display:contents"><dt>Evidence digest</dt><dd><span class="mono">aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa</span></dd></div><div style="display:contents"><dt>Verification</dt><dd>verified</dd></div><div style="display:contents"><dt>Sharing level</dt><dd>approved-full</dd></div></dl></section><section class="panel" aria-labelledby="topology-heading"><h3 id="topology-heading">Home and remote topology</h3><div class="scroll-x"><table><caption>Pinned blocks per chain<span class="visually-hidden"> 1 chains, each pinned to an explicit block number and hash. Comparative reads are never taken at latest.</span></caption><thead><tr><th scope="col">ICM blockchain id</th><th scope="col">EVM chain id</th><th scope="col">Block</th><th scope="col">Block hash</th><th scope="col">Finality basis</th></tr></thead><tbody><tr><th scope="row" class="mono">0x111111…11111111</th><td>43114</td><td>18 446 744 073 709 551 617</td><td class="mono" title="0x4444444444444444444444444444444444444444444444444444444444444444">0x444444…44444444</td><td>avalanche-acceptance</td></tr></tbody></table></div></section><section class="panel" aria-labelledby="census-heading"><h3 id="census-heading">Remote census</h3><dl class="pairs"><div style="display:contents"><dt>Completeness</dt><dd>complete</dd></div><div style="display:contents"><dt>Registered remotes</dt><dd>1</dd></div><div style="display:contents"><dt>Observed</dt><dd>1</dd></div><div style="display:contents"><dt>Missing</dt><dd>none</dd></div><div style="display:contents"><dt>No RPC configured</dt><dd>none</dd></div></dl><p class="caveat">A remote discovered through permissionless registration is a candidate, never automatically trusted. A missing remote is listed, never counted as zero liability.</p></section><section class="panel" aria-labelledby="fingerprint-heading"><h3 id="fingerprint-heading">Contract fingerprints and drift</h3><div class="scroll-x"><table><caption>Deployed code, as observed at the pinned blocks<span class="visually-hidden"> 1 contracts. A fingerprint that is not recognised makes the verdict unknown, never passing.</span></caption><thead><tr><th scope="col">Role</th><th scope="col">Address</th><th scope="col">Runtime code hash</th><th scope="col">Proxy</th><th scope="col">Recognised</th></tr></thead><tbody><tr><th scope="row">erc20-token-remote</th><td class="mono">0x3333333333333333333333333333333333333333</td><td class="mono" title="0x2222222222222222222222222222222222222222222222222222222222222222">0x222222…22222222</td><td>not a proxy</td><td>recognised</td></tr></tbody></table></div></section><section class="panel" aria-labelledby="witness-heading"><h3 id="witness-heading">Witness and finality health</h3><dl class="pairs"><div style="display:contents"><dt>Independent provider groups</dt><dd>2 of 2 required</dd></div><div style="display:contents"><dt>Quorum satisfied</dt><dd>yes</dd></div><div style="display:contents"><dt>Witnesses disagreeing</dt><dd>no</dd></div></dl><div class="scroll-x"><table><caption>Witness votes on the pinned block hashes<span class="visually-hidden"> 2 witnesses. Endpoints appear as pseudonymous ids; no URL or token is published.</span></caption><thead><tr><th scope="col">Endpoint</th><th scope="col">Provider group</th><th scope="col">Trust domain</th><th scope="col">Agreed</th></tr></thead><tbody><tr><th scope="row" class="mono">ep-0123456789abcdef</th><td>alpha-1</td><td>alpha</td><td>agreed</td></tr><tr><th scope="row" class="mono">ep-fedcba9876543210</th><td>beta-1</td><td>beta</td><td>agreed</td></tr></tbody></table></div><p class="caveat">Agreement between independent readers. Not a cryptographic or Byzantine guarantee.</p></section></main>"`;

exports[`every screen state > renders overview/incomplete-census 1`] = `"<main id="main"><h2>Overview</h2><section class="state" data-tone="unknown" aria-labelledby="state-Remote-census-incomplete"><h2 id="state-Remote-census-incomplete">Remote census incomplete</h2><p>At least one registered remote could not be observed, so the liability side is not complete.</p><p class="remedy">Missing remotes are listed, never netted to zero. Restore access to that chain, then re-evaluate.</p></section><section class="panel" aria-labelledby="status-heading"><h3 id="status-heading">Verdict fields</h3><dl class="pairs"><div style="display:contents"><dt>Protocol status</dt><dd><span class="badge" data-tone="unknown"><span class="glyph" aria-hidden="true">?</span><span>Not relied upon</span></span></dd></div><div style="display:contents"><dt>Protocol meaning</dt><dd>A protocol result was reported, but the evidence underneath it is not sound, so it is not presented as a healthy verdict.</dd></div><div style="display:contents"><dt>Reported value</dt><dd>Reconciled — Reported as OK, but the evidence on this page does not support a healthy reading. See the panel above.</dd></div><div style="display:contents"><dt>Data status</dt><dd><span class="badge" data-tone="ok"><span class="glyph" aria-hidden="true">✓</span><span>Complete</span></span></dd></div><div style="display:contents"><dt>Data meaning</dt><dd>Every required observation was collected within its freshness window.</dd></div><div style="display:contents"><dt>Observed at</dt><dd>2026-06-01 11:30:00 UTC (30m ago)</dd></div><div style="display:contents"><dt>Expires at</dt><dd>2026-06-01 12:30:00 UTC</dd></div><div style="display:contents"><dt>Evidence digest</dt><dd><span class="mono">aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa</span></dd></div><div style="display:contents"><dt>Verification</dt><dd>verified</dd></div><div style="display:contents"><dt>Sharing level</dt><dd>approved-full</dd></div></dl></section><section class="panel" aria-labelledby="topology-heading"><h3 id="topology-heading">Home and remote topology</h3><div class="scroll-x"><table><caption>Pinned blocks per chain<span class="visually-hidden"> 1 chains, each pinned to an explicit block number and hash. Comparative reads are never taken at latest.</span></caption><thead><tr><th scope="col">ICM blockchain id</th><th scope="col">EVM chain id</th><th scope="col">Block</th><th scope="col">Block hash</th><th scope="col">Finality basis</th></tr></thead><tbody><tr><th scope="row" class="mono">0x111111…11111111</th><td>43114</td><td>18 446 744 073 709 551 617</td><td class="mono" title="0x4444444444444444444444444444444444444444444444444444444444444444">0x444444…44444444</td><td>avalanche-acceptance</td></tr></tbody></table></div></section><section class="panel" aria-labelledby="census-heading"><h3 id="census-heading">Remote census</h3><dl class="pairs"><div style="display:contents"><dt>Completeness</dt><dd>partial</dd></div><div style="display:contents"><dt>Registered remotes</dt><dd>1</dd></div><div style="display:contents"><dt>Observed</dt><dd>0</dd></div><div style="display:contents"><dt>Missing</dt><dd>0x9999999999999999999999999999999999999999</dd></div><div style="display:contents"><dt>No RPC configured</dt><dd>none</dd></div></dl><p class="caveat">A remote discovered through permissionless registration is a candidate, never automatically trusted. A missing remote is listed, never counted as zero liability.</p></section><section class="panel" aria-labelledby="fingerprint-heading"><h3 id="fingerprint-heading">Contract fingerprints and drift</h3><div class="scroll-x"><table><caption>Deployed code, as observed at the pinned blocks<span class="visually-hidden"> 1 contracts. A fingerprint that is not recognised makes the verdict unknown, never passing.</span></caption><thead><tr><th scope="col">Role</th><th scope="col">Address</th><th scope="col">Runtime code hash</th><th scope="col">Proxy</th><th scope="col">Recognised</th></tr></thead><tbody><tr><th scope="row">erc20-token-remote</th><td class="mono">0x3333333333333333333333333333333333333333</td><td class="mono" title="0x2222222222222222222222222222222222222222222222222222222222222222">0x222222…22222222</td><td>not a proxy</td><td>recognised</td></tr></tbody></table></div></section><section class="panel" aria-labelledby="witness-heading"><h3 id="witness-heading">Witness and finality health</h3><dl class="pairs"><div style="display:contents"><dt>Independent provider groups</dt><dd>2 of 2 required</dd></div><div style="display:contents"><dt>Quorum satisfied</dt><dd>yes</dd></div><div style="display:contents"><dt>Witnesses disagreeing</dt><dd>no</dd></div></dl><div class="scroll-x"><table><caption>Witness votes on the pinned block hashes<span class="visually-hidden"> 2 witnesses. Endpoints appear as pseudonymous ids; no URL or token is published.</span></caption><thead><tr><th scope="col">Endpoint</th><th scope="col">Provider group</th><th scope="col">Trust domain</th><th scope="col">Agreed</th></tr></thead><tbody><tr><th scope="row" class="mono">ep-0123456789abcdef</th><td>alpha-1</td><td>alpha</td><td>agreed</td></tr><tr><th scope="row" class="mono">ep-fedcba9876543210</th><td>beta-1</td><td>beta</td><td>agreed</td></tr></tbody></table></div><p class="caveat">Agreement between independent readers. Not a cryptographic or Byzantine guarantee.</p></section></main>"`;

exports[`every screen state > renders overview/sanitized-metadata 1`] = `"<main id="main"><h2>Overview</h2><section class="state" data-tone="ok" aria-labelledby="state-Reconciled-at-the-pinned-blocks"><h2 id="state-Reconciled-at-the-pinned-blocks">Reconciled at the pinned blocks</h2><p>Every required check completed on fresh evidence and none of them failed.</p><p class="remedy">Nothing to do. Open the evidence bundle if you need the pinned blocks.</p></section><section class="panel" aria-labelledby="status-heading"><h3 id="status-heading">Verdict fields</h3><dl class="pairs"><div style="display:contents"><dt>Protocol status</dt><dd><span class="badge" data-tone="ok"><span class="glyph" aria-hidden="true">✓</span><span>Reconciled</span></span></dd></div><div style="display:contents"><dt>Protocol meaning</dt><dd>Observed onchain coverage reconciled at the pinned blocks.</dd></div><div style="display:contents"><dt>Data status</dt><dd><span class="badge" data-tone="ok"><span class="glyph" aria-hidden="true">✓</span><span>Complete</span></span></dd></div><div style="display:contents"><dt>Data meaning</dt><dd>Every required observation was collected within its freshness window.</dd></div><div style="display:contents"><dt>Observed at</dt><dd>2026-06-01 11:30:00 UTC (30m ago)</dd></div><div style="display:contents"><dt>Expires at</dt><dd>2026-06-01 12:30:00 UTC</dd></div><div style="display:contents"><dt>Evidence digest</dt><dd><span class="mono">aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa</span></dd></div><div style="display:contents"><dt>Verification</dt><dd>verified</dd></div><div style="display:contents"><dt>Sharing level</dt><dd>sanitized-metadata</dd></div></dl></section><section class="panel" aria-labelledby="topology-heading"><h3 id="topology-heading">Home and remote topology</h3><p>Chain topology is not published at the <code>sanitized-metadata</code> sharing level. This is an operator choice, not a gap in the evaluation: the local agent still evaluated it.</p></section><section class="panel" aria-labelledby="census-heading"><h3 id="census-heading">Remote census</h3><p>The remote census is not published at the <code>sanitized-metadata</code> sharing level. This is an operator choice, not a gap in the evaluation: the local agent still evaluated it.</p></section><section class="panel" aria-labelledby="fingerprint-heading"><h3 id="fingerprint-heading">Contract fingerprints and drift</h3><p>Contract fingerprints is not published at the <code>sanitized-metadata</code> sharing level. This is an operator choice, not a gap in the evaluation: the local agent still evaluated it.</p></section><section class="panel" aria-labelledby="witness-heading"><h3 id="witness-heading">Witness and finality health</h3><p>Witness detail is not published at the <code>sanitized-metadata</code> sharing level. This is an operator choice, not a gap in the evaluation: the local agent still evaluated it.</p></section></main>"`;

exports[`every screen state > renders overview/split-brain 1`] = `"<main id="main"><h2>Overview</h2><section class="state" data-tone="critical" aria-labelledby="state-Independent-witnesses-disagree"><h2 id="state-Independent-witnesses-disagree">Independent witnesses disagree</h2><p>Two independent provider groups reported different history for the same pinned height.</p><p class="remedy">Treat this as a data fault, not a tiebreak. Identify the diverging provider before trusting either answer.</p></section><section class="panel" aria-labelledby="status-heading"><h3 id="status-heading">Verdict fields</h3><dl class="pairs"><div style="display:contents"><dt>Protocol status</dt><dd><span class="badge" data-tone="unknown"><span class="glyph" aria-hidden="true">?</span><span>Not relied upon</span></span></dd></div><div style="display:contents"><dt>Protocol meaning</dt><dd>A protocol result was reported, but the evidence underneath it is not sound, so it is not presented as a healthy verdict.</dd></div><div style="display:contents"><dt>Reported value</dt><dd>Reconciled — Reported as OK, but the data status is DIVERGENT. A conclusion drawn from evidence that is not sound is not shown as healthy.</dd></div><div style="display:contents"><dt>Data status</dt><dd><span class="badge" data-tone="critical"><span class="glyph" aria-hidden="true">⇄</span><span>Witnesses disagree</span></span></dd></div><div style="display:contents"><dt>Data meaning</dt><dd>Independent providers reported different history. This is a data fault, not a tiebreak.</dd></div><div style="display:contents"><dt>Observed at</dt><dd>2026-06-01 11:30:00 UTC (30m ago)</dd></div><div style="display:contents"><dt>Expires at</dt><dd>2026-06-01 12:30:00 UTC</dd></div><div style="display:contents"><dt>Evidence digest</dt><dd><span class="mono">aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa</span></dd></div><div style="display:contents"><dt>Verification</dt><dd>verified</dd></div><div style="display:contents"><dt>Sharing level</dt><dd>approved-full</dd></div></dl></section><section class="panel" aria-labelledby="topology-heading"><h3 id="topology-heading">Home and remote topology</h3><div class="scroll-x"><table><caption>Pinned blocks per chain<span class="visually-hidden"> 1 chains, each pinned to an explicit block number and hash. Comparative reads are never taken at latest.</span></caption><thead><tr><th scope="col">ICM blockchain id</th><th scope="col">EVM chain id</th><th scope="col">Block</th><th scope="col">Block hash</th><th scope="col">Finality basis</th></tr></thead><tbody><tr><th scope="row" class="mono">0x111111…11111111</th><td>43114</td><td>18 446 744 073 709 551 617</td><td class="mono" title="0x4444444444444444444444444444444444444444444444444444444444444444">0x444444…44444444</td><td>avalanche-acceptance</td></tr></tbody></table></div></section><section class="panel" aria-labelledby="census-heading"><h3 id="census-heading">Remote census</h3><dl class="pairs"><div style="display:contents"><dt>Completeness</dt><dd>complete</dd></div><div style="display:contents"><dt>Registered remotes</dt><dd>1</dd></div><div style="display:contents"><dt>Observed</dt><dd>1</dd></div><div style="display:contents"><dt>Missing</dt><dd>none</dd></div><div style="display:contents"><dt>No RPC configured</dt><dd>none</dd></div></dl><p class="caveat">A remote discovered through permissionless registration is a candidate, never automatically trusted. A missing remote is listed, never counted as zero liability.</p></section><section class="panel" aria-labelledby="fingerprint-heading"><h3 id="fingerprint-heading">Contract fingerprints and drift</h3><div class="scroll-x"><table><caption>Deployed code, as observed at the pinned blocks<span class="visually-hidden"> 1 contracts. A fingerprint that is not recognised makes the verdict unknown, never passing.</span></caption><thead><tr><th scope="col">Role</th><th scope="col">Address</th><th scope="col">Runtime code hash</th><th scope="col">Proxy</th><th scope="col">Recognised</th></tr></thead><tbody><tr><th scope="row">erc20-token-remote</th><td class="mono">0x3333333333333333333333333333333333333333</td><td class="mono" title="0x2222222222222222222222222222222222222222222222222222222222222222">0x222222…22222222</td><td>not a proxy</td><td>recognised</td></tr></tbody></table></div></section><section class="panel" aria-labelledby="witness-heading"><h3 id="witness-heading">Witness and finality health</h3><dl class="pairs"><div style="display:contents"><dt>Independent provider groups</dt><dd>2 of 2 required</dd></div><div style="display:contents"><dt>Quorum satisfied</dt><dd>yes</dd></div><div style="display:contents"><dt>Witnesses disagreeing</dt><dd>yes</dd></div></dl><div class="scroll-x"><table><caption>Witness votes on the pinned block hashes<span class="visually-hidden"> 2 witnesses. Endpoints appear as pseudonymous ids; no URL or token is published.</span></caption><thead><tr><th scope="col">Endpoint</th><th scope="col">Provider group</th><th scope="col">Trust domain</th><th scope="col">Agreed</th></tr></thead><tbody><tr><th scope="row" class="mono">ep-0123456789abcdef</th><td>alpha-1</td><td>alpha</td><td>agreed</td></tr><tr><th scope="row" class="mono">ep-fedcba9876543210</th><td>beta-1</td><td>beta</td><td>disagreed</td></tr></tbody></table></div><p class="caveat">Agreement between independent readers. Not a cryptographic or Byzantine guarantee.</p></section></main>"`;

