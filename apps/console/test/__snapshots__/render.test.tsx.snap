// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`every screen state > renders coverage/canonical-erc20 1`] = `"<main id="main"><h2>Coverage</h2><section class="panel" aria-labelledby="claim-heading"><h3 id="claim-heading">Canonical ERC20 — reconciliation</h3><dl class="pairs"><div style="display:contents"><dt>Asset mode</dt><dd>canonical-erc20</dd></div><div style="display:contents"><dt>Claim</dt><dd>Exact reconciliation</dd></div><div style="display:contents"><dt>What this means</dt><dd>Home-side liabilities and remote-side supply reconcile exactly at the pinned blocks, including pending envelopes.</dd></div><div style="display:contents"><dt>What this does not claim</dt><dd>This is observed onchain coverage, not a statement about legal recoverability.</dd></div><div style="display:contents"><dt>Coverage</dt><dd>COMPLETE — Every approved remote in the census was observed at a pinned block.</dd></div><div style="display:contents"><dt>Reason codes</dt><dd>none</dd></div></dl></section><section class="panel" aria-labelledby="rule-gate-a-conservation"><h3 id="rule-gate-a-conservation">gate-a-conservation <span class="mono">v1</span></h3><dl class="pairs"><div style="display:contents"><dt>Result</dt><dd>PASS</dd></div><div style="display:contents"><dt>Unit</dt><dd>base-units</dd></div><div style="display:contents"><dt>Reason codes</dt><dd>none</dd></div></dl><div class="scroll-x"><table><caption>Inputs and intermediates for gate-a-conservation<span class="visually-hidden"> 2 inputs and 1 intermediate values, all exact base-unit integers.</span></caption><thead><tr><th scope="col">Name</th><th scope="col">Kind</th><th scope="col">Base units</th></tr></thead><tbody><tr><th scope="row">remoteSupply</th><td>input</td><td class="mono">340 282 366 920 938 463 463 374 607 431 768 211 455</td></tr><tr><th scope="row">transferredBalance</th><td>input</td><td class="mono">340 282 366 920 938 463 463 374 607 431 768 211 455</td></tr><tr><th scope="row">difference</th><td>intermediate</td><td class="mono">0</td></tr></tbody></table></div></section><section class="panel" aria-labelledby="assumptions-heading"><h3 id="assumptions-heading">Assumptions and exclusions</h3><dl class="pairs"><div style="display:contents"><dt>Assumptions</dt><dd><ul><li>Providers do not share an undisclosed upstream.</li></ul></dd></div><div style="display:contents"><dt>Exclusions</dt><dd><ul><li>Contract source audit.</li></ul></dd></div><div style="display:contents"><dt>Non-goals</dt><dd><ul><li>Preventing an exploit.</li></ul></dd></div></dl></section><p class="caveat">Observed onchain coverage at pinned blocks. This is not a legal or financial recoverability opinion, and it is not an audit of the contracts.</p></main>"`;

exports[`every screen state > renders coverage/loading 1`] = `"<main id="main"><section class="state" data-tone="neutral" aria-labelledby="state-Loading"><h2 id="state-Loading">Loading</h2><p>Loading from the hosted API…</p><p aria-live="polite" class="visually-hidden">Loading from the hosted API…</p></section></main>"`;

exports[`every screen state > renders coverage/native-indeterminate 1`] = `"<main id="main"><h2>Coverage</h2><section class="panel" aria-labelledby="claim-heading"><h3 id="claim-heading">Native remote — upper bound</h3><dl class="pairs"><div style="display:contents"><dt>Asset mode</dt><dd>native</dd></div><div style="display:contents"><dt>Claim</dt><dd>Indeterminate</dd></div><div style="display:contents"><dt>What this means</dt><dd>The reconstructed upper bound exceeds the observed coverage. On its own this is not a shortfall: an unobserved fee burn may already have reduced real supply.</dd></div><div style="display:contents"><dt>What this does not claim</dt><dd>A red economic verdict needs a trustworthy supply lower bound to exceed coverage as well.</dd></div><div style="display:contents"><dt>Coverage</dt><dd>PARTIAL — Some approved remotes could not be observed. Coverage is incomplete and is not netted.</dd></div><div style="display:contents"><dt>Reason codes</dt><dd>none</dd></div></dl><p class="caveat">Native mode reports sufficient, indeterminate or unknown only. The reported supply is an accounting reconstruction, so no equality claim is made.</p></section><section class="panel" aria-labelledby="rule-native-upper-bound"><h3 id="rule-native-upper-bound">native-upper-bound <span class="mono">v1</span></h3><dl class="pairs"><div style="display:contents"><dt>Result</dt><dd>PASS</dd></div><div style="display:contents"><dt>Unit</dt><dd>base-units</dd></div><div style="display:contents"><dt>Reason codes</dt><dd>none</dd></div></dl><div class="scroll-x"><table><caption>Inputs and intermediates for native-upper-bound<span class="visually-hidden"> 2 inputs and 1 intermediate values, all exact base-unit integers.</span></caption><thead><tr><th scope="col">Name</th><th scope="col">Kind</th><th scope="col">Base units</th></tr></thead><tbody><tr><th scope="row">remoteSupply</th><td>input</td><td class="mono">340 282 366 920 938 463 463 374 607 431 768 211 455</td></tr><tr><th scope="row">transferredBalance</th><td>input</td><td class="mono">340 282 366 920 938 463 463 374 607 431 768 211 455</td></tr><tr><th scope="row">difference</th><td>intermediate</td><td class="mono">0</td></tr></tbody></table></div></section><section class="panel" aria-labelledby="assumptions-heading"><h3 id="assumptions-heading">Assumptions and exclusions</h3><dl class="pairs"><div style="display:contents"><dt>Assumptions</dt><dd><ul><li>Providers do not share an undisclosed upstream.</li></ul></dd></div><div style="display:contents"><dt>Exclusions</dt><dd><ul><li>Contract source audit.</li></ul></dd></div><div style="display:contents"><dt>Non-goals</dt><dd><ul><li>Preventing an exploit.</li></ul></dd></div></dl></section><p class="caveat">Observed onchain coverage at pinned blocks. This is not a legal or financial recoverability opinion, and it is not an audit of the contracts.</p></main>"`;

exports[`every screen state > renders coverage/native-upper-bound 1`] = `"<main id="main"><h2>Coverage</h2><section class="panel" aria-labelledby="claim-heading"><h3 id="claim-heading">Native remote — upper bound</h3><dl class="pairs"><div style="display:contents"><dt>Asset mode</dt><dd>native</dd></div><div style="display:contents"><dt>Claim</dt><dd>Reported supply upper bound is covered</dd></div><div style="display:contents"><dt>What this means</dt><dd>The reconstructed upper bound U does not exceed the observed home-side coverage A at the pinned blocks.</dd></div><div style="display:contents"><dt>What this does not claim</dt><dd>This is an upper bound, not a supply figure, and it holds only under the stated minter-exclusivity and burn-path assumptions.</dd></div><div style="display:contents"><dt>Coverage</dt><dd>COMPLETE — Every approved remote in the census was observed at a pinned block.</dd></div><div style="display:contents"><dt>Reason codes</dt><dd>none</dd></div></dl><p class="caveat">Native mode reports sufficient, indeterminate or unknown only. The reported supply is an accounting reconstruction, so no equality claim is made.</p></section><section class="panel" aria-labelledby="rule-native-upper-bound"><h3 id="rule-native-upper-bound">native-upper-bound <span class="mono">v1</span></h3><dl class="pairs"><div style="display:contents"><dt>Result</dt><dd>PASS</dd></div><div style="display:contents"><dt>Unit</dt><dd>base-units</dd></div><div style="display:contents"><dt>Reason codes</dt><dd>none</dd></div></dl><div class="scroll-x"><table><caption>Inputs and intermediates for native-upper-bound<span class="visually-hidden"> 2 inputs and 1 intermediate values, all exact base-unit integers.</span></caption><thead><tr><th scope="col">Name</th><th scope="col">Kind</th><th scope="col">Base units</th></tr></thead><tbody><tr><th scope="row">remoteSupply</th><td>input</td><td class="mono">340 282 366 920 938 463 463 374 607 431 768 211 455</td></tr><tr><th scope="row">transferredBalance</th><td>input</td><td class="mono">340 282 366 920 938 463 463 374 607 431 768 211 455</td></tr><tr><th scope="row">difference</th><td>intermediate</td><td class="mono">0</td></tr></tbody></table></div></section><section class="panel" aria-labelledby="assumptions-heading"><h3 id="assumptions-heading">Assumptions and exclusions</h3><dl class="pairs"><div style="display:contents"><dt>Assumptions</dt><dd><ul><li>Providers do not share an undisclosed upstream.</li></ul></dd></div><div style="display:contents"><dt>Exclusions</dt><dd><ul><li>Contract source audit.</li></ul></dd></div><div style="display:contents"><dt>Non-goals</dt><dd><ul><li>Preventing an exploit.</li></ul></dd></div></dl></section><p class="caveat">Observed onchain coverage at pinned blocks. This is not a legal or financial recoverability opinion, and it is not an audit of the contracts.</p></main>"`;

exports[`every screen state > renders coverage/not-shared 1`] = `"<main id="main"><h2>Coverage</h2><section class="panel"><p>Coverage detail is not published at the <code>sanitized-metadata</code> sharing level. The local agent evaluated it; the operator chose not to upload the bundle.</p><p>Raise the sharing level, or read the bundle locally with <code>ictt-sentinel evidence export</code>.</p></section></main>"`;

exports[`every screen state > renders deployments/critical 1`] = `"<main id="main"><h2>Deployments</h2><div class="scroll-x"><table><caption>Deployments this token may read<span class="visually-hidden"> 1 deployments. Each row reports a protocol status and a data status separately, plus how fresh the evidence is.</span></caption><thead><tr><th scope="col">Deployment</th><th scope="col">Protocol status</th><th scope="col">Data status</th><th scope="col">Freshness</th><th scope="col">Last evidence</th><th scope="col">Chains</th></tr></thead><tbody><tr><th scope="row"><a href="#/d/acme-usdc">acme-usdc</a></th><td><span class="badge" data-tone="critical"><span class="glyph" aria-hidden="true">✕</span><span>Breach observed</span></span><div class="visually-hidden">Deterministic accounting breach observed with sufficient evidence at pinned blocks. This is a proven breach, not a blind spot.</div></td><td><span class="badge" data-tone="ok"><span class="glyph" aria-hidden="true">✓</span><span>Complete</span></span></td><td>Fresh · observed 30m ago</td><td><a href="#/d/acme-usdc/evidence/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"><span class="mono" title="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa">aaaaaaaa…aaaaaaaa</span></a><div class="visually-hidden">2026-06-01 11:30:00 UTC</div></td><td>Not shared at approved-full</td></tr></tbody></table></div><p class="caveat">This product reports evidence classes, not a single security score: a breach and a blind spot need opposite responses. All times are UTC.</p></main>"`;

exports[`every screen state > renders deployments/empty 1`] = `"<main id="main"><section class="state" data-tone="neutral" aria-labelledby="state-Nothing-to-show"><h2 id="state-Nothing-to-show">Nothing to show</h2><p>No deployments granted.</p><p class="remedy">Ask an operator for a grant.</p></section></main>"`;

