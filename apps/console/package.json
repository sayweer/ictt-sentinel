{
  "name": "@ictt-sentinel/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Optional read-only evidence UI.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "ictt-sentinel": {
    "layer": 3,
    "mayDependOn": [
      "@ictt-sentinel/domain",
      "@ictt-sentinel/evidence"
    ]
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --build --force",
    "build": "tsc --build",
    "build:web": "vite build",
    "clean": "tsc --build --clean",
    "test": "vitest run --root ../..",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ictt-sentinel/domain": "workspace:*",
    "@ictt-sentinel/evidence": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "10.9.1",
    "happy-dom": "20.14.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
