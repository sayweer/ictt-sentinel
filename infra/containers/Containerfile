FROM node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS build

ENV PNPM_HOME=/opt/pnpm
ENV PATH=/opt/pnpm:$PATH

WORKDIR /workspace

RUN corepack enable \
  && corepack prepare pnpm@11.10.0 --activate

COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm run build
RUN pnpm --filter @ictt-sentinel/agent deploy --prod --legacy /release/agent \
  && pnpm --filter @ictt-sentinel/api deploy --prod --legacy /release/api \
  && pnpm --filter @ictt-sentinel/storage-postgres deploy --prod --legacy /release/migrate

FROM node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS runtime-base

ENV NODE_ENV=production

RUN groupadd --gid 10001 sentinel \
  && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent \
    --shell /usr/sbin/nologin sentinel

WORKDIR /opt/ictt-sentinel

USER 10001:10001

FROM runtime-base AS agent
COPY --from=build --chown=10001:10001 /release/agent ./
EXPOSE 9464
CMD ["node", "dist/main.js"]

FROM runtime-base AS api
COPY --from=build --chown=10001:10001 /release/api ./
EXPOSE 8080
CMD ["node", "dist/main.js"]

FROM runtime-base AS migrate
COPY --from=build --chown=10001:10001 /release/migrate ./
CMD ["node", "dist/cli.js"]
